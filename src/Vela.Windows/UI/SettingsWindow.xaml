<Window x:Class="Vela.Windows.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <NavigationView x:Name="Navigation" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" OpenPaneLength="220" SelectionChanged="NavigationChanged">
            <NavigationView.PaneHeader><StackPanel Margin="16,12,0,16" Spacing="4"><TextBlock FontFamily="Segoe UI Variable" Text="Vela" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock FontFamily="Segoe UI Variable" Text="Settings" Style="{StaticResource VelaCaption}"/></StackPanel></NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="General" Tag="General"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Features" Tag="Features"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80A;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Input" Tag="Input"><NavigationViewItem.Icon><FontIcon Glyph="&#xE765;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Shortcuts" Tag="Shortcuts"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D2;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Access &amp; data" Tag="Data"><NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;"/></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems><NavigationViewItem Content="About" Tag="About"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.FooterMenuItems>
            <ScrollViewer x:Name="PageScroll" ZoomMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="Page" Padding="28,24,28,32" Spacing="12" MaxWidth="920" Width="{Binding ElementName=PageScroll, Path=ViewportWidth}" HorizontalAlignment="Left">
                    <TextBlock FontFamily="Segoe UI Variable" x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12"/>
                    <InfoBar x:Name="Status" IsOpen="False" Severity="Informational"/>
                    <StackPanel x:Name="Rows" Spacing="8"/>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
