<UserControl
    x:Class="Vela.Windows.UI.ShelfDropSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True" UseLayoutRounding="True"
    AutomationProperties.Name="Vela File shelf drop target">
    <Grid x:Name="HitArea" Background="Transparent">
        <Grid x:Name="Emphasis" Opacity="0">
            <Border x:Name="Highlight" Margin="6" CornerRadius="6"
                    Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.12"/>
            <Border x:Name="Badge" Width="10" Height="10" CornerRadius="5" Margin="8"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                <Viewbox><Canvas Width="10" Height="10">
                    <Path Data="M5 2.5 V7.5 M2.5 5 H7.5" StrokeThickness="1"
                          Stroke="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas></Viewbox>
            </Border>
            <Border x:Name="Caption" Visibility="Collapsed" CornerRadius="6" Padding="12,4" Margin="6"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <TextBlock Text="Drop to File shelf" FontFamily="Segoe UI Variable"
                           Style="{StaticResource BodyTextBlockStyle}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
