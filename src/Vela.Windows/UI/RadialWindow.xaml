<Window x:Class="Vela.Windows.UI.RadialWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Content="&#xE72B;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"
                AutomationProperties.Name="Back to parent menu" ToolTipService.ToolTip="Back (Backspace or Left arrow)"/>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:Name="Profile" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button x:Name="ManageButton" Grid.Column="2" Content="&#xE713;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"
                AutomationProperties.Name="Manage launchers" ToolTipService.ToolTip="Manage launchers"/>
        </Grid>
        <Grid x:Name="MenuArea" Grid.Row="1">
            <Canvas x:Name="Wheel" Width="408" Height="368" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ScrollViewer x:Name="ListScroll" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MenuList" Spacing="8"/>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock x:Name="Error" Visibility="Collapsed" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                Text="1–8 choose · ↑/↓ move · Enter open&#xA;Backspace back · Esc close"/>
        </StackPanel>
    </Grid>
</Window>
