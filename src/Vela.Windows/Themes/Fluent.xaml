<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable</FontFamily>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CheckBoxCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="GridViewItemCheckBoxCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ListViewItemCheckBoxCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="VelaCardCornerRadius">8</CornerRadius>
    <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource CheckBoxCornerRadius}"/>
    </Style>
    <Style x:Key="VelaCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="VelaCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="VelaBody" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="VelaTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
</ResourceDictionary>
